# TrafficTwin AI Environment Configuration

# Firebase Configuration (emulator or production)
FIREBASE_ENV=emulator
FIREBASE_PROJECT_ID=traffictwin-ai-tn
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=traffictwin-ai-tn-default-rtdb

# Production Firebase Service Account (optional for demo)
# FIREBASE_SERVICE_ACCOUNT_PATH=backend/serviceAccountKey.json

# API Keys & Mock Flags (Defaults to clean realistic mock data providers)
USE_MOCK_APIS=true
TOMTOM_API_KEY=mock_tomtom_api_key
OPENWEATHER_API_KEY=mock_openweather_api_key

# Flask Backend Server Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1

# Frontend Configuration
VITE_API_URL=http://127.0.0.1:5000
VITE_FIREBASE_PROJECT_ID=traffictwin-ai-tn
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=traffictwin-ai-tn-default-rtdb
VITE_FIREBASE_API_KEY=fake-api-key-for-emulator
VITE_USE_EMULATOR=true
